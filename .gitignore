# =============================================================================
#  IntelliBI Sales Automation — .gitignore
#  Keeps SECRETS and machine-local artifacts out of version control.
# =============================================================================

# ── Secrets / credentials (NEVER commit) ─────────────────────────────────────
credentials/*
!credentials/README.md
!credentials/*.example.json
!credentials/*.example.py
# email_config.py holds a Gmail app password -> never commit
credentials/email_config.py

# ── Runtime working folders ──────────────────────────────────────────────────
cache/
temp/
logs/
output/reports/*
output/exports/*
!output/reports/.gitkeep
!output/exports/.gitkeep

# Optional historical training data (large, machine-local)
intellibi_lead_cycle/*
!intellibi_lead_cycle/README.md

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# ── OS / editor cruft ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
~$*
*.log
*.tmp
